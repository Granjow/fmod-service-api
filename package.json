{
  "name": "@geheimgang188/fmod-service-api",
  "version": "3.0.0",
  "description": "FMOD service API",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "files": [
    "dist/src/*",
    "src/api-generator/templates/*",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "tsc": "tsc",
    "lint": "eslint -c .eslintrc.js \"src/**\" \"spec/**\"",
    "test": "jest --forceExit",
    "prepack": "rm -rf dist && npm run build",
    "prepublishOnly": "npm run test"
  },
  "repository": {
    "type": "git",
    "url": "git@github.com:Granjow/fmod-service-api.git"
  },
  "keywords": [
    "fmod",
    "service",
    "zmq",
    "zeromq"
  ],
  "author": "Simon A. Eugster <simon.eu@gmail.com>",
  "license": "ISC",
  "dependencies": {
    "camelcase": "6.3.0",
    "semaphore-promise": "1.4.3",
    "small-state-machine": "4.2.1",
    "zeromq": "6.0.0-beta.6"
  },
  "devDependencies": {
    "@types/jest": "^29.2.4",
    "@types/node": "^22.19.17",
    "@types/zeromq": "6.0.0",
    "@typescript-eslint/eslint-plugin": "^5.46.0",
    "@typescript-eslint/parser": "^5.46.0",
    "eslint": "^8.29.0",
    "jest": "^29.7.0",
    "pino": "^8.21.0",
    "tiny-typed-emitter": "^2.1.0",
    "typescript": "5.9.3"
  },
  "jest": {
    "clearMocks": true,
    "collectCoverage": true,
    "coverageDirectory": "coverage",
    "coverageReporters": [
      "lcov",
      "text"
    ],
    "roots": [
      "dist/"
    ],
    "testEnvironment": "node"
  }
}
